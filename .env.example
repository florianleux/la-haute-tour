# Base locale (dev). En prod : TURSO_DATABASE_URL + TURSO_AUTH_TOKEN (env vars Netlify).
# Les deux peuvent coexister ici : DATABASE_URL gagne, donc dev reste en local.
# Pour migrer la prod : pnpm db:migrate:prod
DATABASE_URL=file:./local.db
# TURSO_DATABASE_URL=libsql://xxx.turso.io
# TURSO_AUTH_TOKEN=

# Secret de scellement du cookie de session (>= 32 caractères).
NUXT_SESSION_PASSWORD=change-me-with-at-least-32-characters

# App Discord OAuth2 (Discord Developer Portal).
NUXT_DISCORD_CLIENT_ID=
NUXT_DISCORD_CLIENT_SECRET=
NUXT_DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
