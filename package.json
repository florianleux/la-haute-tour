{
  "name": "la-haute-tour",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "DATABASE_URL= drizzle-kit migrate",
    "db:import": "tsx --env-file-if-exists=.env scripts/import-questions.ts",
    "db:seed-flags": "tsx --env-file-if-exists=.env scripts/seed-flags.ts",
    "db:seed-flags:prod": "DATABASE_URL= tsx --env-file-if-exists=.env scripts/seed-flags.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@libsql/client": "^0.15.9",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^3.19.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/test-utils": "^3.19.2",
    "@tailwindcss/vite": "^4.1.12",
    "@vue/test-utils": "^2.4.6",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.34.0",
    "h3": "1.15.11",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10"
  }
}
